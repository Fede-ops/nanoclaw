TELEGRAM_BOT_TOKEN=

# Timezone for scheduled tasks (cron expressions). Without this, the server's
# system timezone is used — on most cloud/VPS servers that is UTC, which means
# "0 9 * * *" fires at 9:00 UTC (= 11:00 CEST in summer, 10:00 CET in winter).
# Set to your local IANA timezone name:
#   Europe/Vienna, Europe/Berlin, Europe/Zurich, America/New_York, etc.
TZ=Europe/Vienna
